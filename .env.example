FLASK_ENV=development
PORT=5000
APP_URL=http://localhost:5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teso_market
SESSION_SECRET=change-me-to-a-long-random-string
IPN_SECRET=change-me-another-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-12chars+
# Pesapal: sandbox keys from https://developer.pesapal.com ; PESAPAL_ENV=live only after merchant approval
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
# MTN/Airtel direct payment channels require a separately approved provider adapter and credentials.
# Gmail / Google Workspace SMTP for password-reset emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
